 "cumleler": [
  {
   "metin": "Kapıyı açtın. Koridor bomboştu.",
   "bas": 0,
   "son": 85
  },
  {
   "metin": "Çıplak ayakların buz gibi tahtaya değdi.",
   "bas": 85,
   "son": 177
  },
  {
   "metin": "Fısıltı kesilmişti. Yalnızca duvar saatinin tıkırtısı vardı.",
   "bas": 177,
   "son": 322
  },
  {
   "metin": "Babaannenin kapısı aralıktı. İçeriden sarı bir gece lambası ışığı sızıyordu.",
   "bas": 322,
   "son": 493
  },
  {
   "metin": "İçeri baktın. Babaannen yorganına sarılmış, uyuyordu.",
   "bas": 493,
   "son": 621
  },
  {
   "metin": "Tam dönecekken gözün duvara takıldı.",
   "bas": 621,
   "son": 697
  },
  {
   "metin": "Lambanın vurduğu duvarda, babaannenin gölgesi vardı.",
   "bas": 697,
   "son": 808
  },
  {
   "metin": "Ama gölge yatmıyordu. Ayaktaydı.",
   "bas": 808,
   "son": 902
  },
  {
   "metin": "Uzun, ince kolları neredeyse yere değiyordu.",
   "bas": 902,
   "son": 1015
  },
  {
   "metin": "Nefesini tuttun, geri bir adım attın. Tahta gıcırdadı.",
   "bas": 1015,
   "son": 1155
  },
  {
   "metin": "Gölge, yavaşça başını sana çevirdi.",
   "bas": 1155,
   "son": 1254
  },
  {
   "metin": "Sen olsan kaçar mıydın, yoksa babaanneni mi uyandırırdın? Yorumlara yaz.",
   "bas": 1254,
   "son": 1447
  }
 ],
