 "cumleler": [
  {
   "metin": "Gece uyandın ve kımıldayamıyorsun.",
   "bas": 0,
   "son": 79
  },
  {
   "metin": "Üç gün önce, sınavlardan kaçıp köydeki babaannenin evine gelmiştin.",
   "bas": 79,
   "son": 214
  },
  {
   "metin": "Babaannen sana sarıldı, önüne sıcak bir çorba koydu.",
   "bas": 214,
   "son": 336
  },
  {
   "metin": "Sonra evin en eski odasını hazırladı.",
   "bas": 336,
   "son": 435
  },
  {
   "metin": "Odada büyük, aynalı bir dolap vardı. Ayna, tam yatağa bakıyordu.",
   "bas": 435,
   "son": 592
  },
  {
   "metin": "İlk gece her şey sessizdi. Fazla sessiz.",
   "bas": 592,
   "son": 700
  },
  {
   "metin": "Şimdi ise göğsüne bir ağırlık çökmüş. Sanki biri üstüne oturmuş.",
   "bas": 700,
   "son": 847
  },
  {
   "metin": "Bağırmak istiyorsun, sesin çıkmıyor. Parmağını bile oynatamıyorsun.",
   "bas": 847,
   "son": 1008
  },
  {
   "metin": "Gözlerin karanlıkta aynayı buluyor.",
   "bas": 1008,
   "son": 1078
  },
  {
   "metin": "Aynada yatağın görünüyor. Sen yatıyorsun...",
   "bas": 1078,
   "son": 1185
  },
  {
   "metin": "...ve göğsünün üstünde, kapkara bir şey oturmuş. Sana bakıyor.",
   "bas": 1185,
   "son": 1355
  },
  {
   "metin": "Sen olsan o gece o odada kalır mıydın? Yorumlara yaz.",
   "bas": 1355,
   "son": 1502
  }
 ],
