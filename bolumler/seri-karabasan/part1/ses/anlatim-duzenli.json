dın? Yorumlara yaz.", "kesimler": [[2.4579999999999997, 0.2390000000000001], [7.195, 0.123], [11.386000000000001, 0.018999999999999018], [14.717999999999998, 0.123], [17.631999999999998, 0.030000000000001803], [28.592, 0.06499999999999839], [38.425, 0.565000000000002], [46.157, 0.565000000000002]]}