 "cumleler": [
  {
   "metin": "Tam yüzünün üstündeydi.",
   "bas": 0,
   "son": 53
  },
  {
   "metin": "Dumandan bir beden. Kor gibi iki göz.",
   "bas": 53,
   "son": 156
  },
  {
   "metin": "Göğsün sıkıştı, panik büyüdü.",
   "bas": 156,
   "son": 235
  },
  {
   "metin": "Sonra doktorun sözü aklına geldi: Önce küçük bir şeyi oynatmayı dene. Bir parmağını. Ve yavaş nefes al.",
   "bas": 235,
   "son": 470
  },
  {
   "metin": "Nefes aldın. Dörde kadar saydın. Verdin.",
   "bas": 470,
   "son": 572
  },
  {
   "metin": "Bütün aklını serçe parmağına verdin. Kıpırda, dedin. Kıpırda.",
   "bas": 572,
   "son": 721
  },
  {
   "metin": "Parmağın oynadı.",
   "bas": 721,
   "son": 756
  },
  {
   "metin": "Ve karaltı, rüzgârdaki duman gibi dağıldı. Pencereden ilk ışık süzüldü.",
   "bas": 756,
   "son": 929
  },
  {
   "metin": "Kahvaltıda babaannene her şeyi anlattın. Muskayı da.",
   "bas": 929,
   "son": 1044
  },
  {
   "metin": "Babaannen çay bardağını bıraktı. Sana uzun uzun baktı.",
   "bas": 1044,
   "son": 1189
  },
  {
   "metin": "O gece seni uyandırmaya kıyamadım, dedi. Muskayı koyamadım ki.",
   "bas": 1189,
   "son": 1361
  },
  {
   "metin": "Peki yastığının altına onu kim koydu?",
   "bas": 1361,
   "son": 1473
  },
  {
   "metin": "Sen olsan bu soruyu sorar mıydın? Yorumlara yaz.",
   "bas": 1473,
   "son": 1596
  }
 ],
