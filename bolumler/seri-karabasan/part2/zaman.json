 "cumleler": [
  {
   "metin": "Babaannen tek kelime söyledi: Karabasan.",
   "bas": 0,
   "son": 107
  },
  {
   "metin": "Sabah mutfakta çay demleniyordu, ama babaannen gülmüyordu.",
   "bas": 107,
   "son": 229
  },
  {
   "metin": "Anadolu'da anlatılır: Karabasan, uyuyanın göğsüne çöker ve bastırır.",
   "bas": 229,
   "son": 391
  },
  {
   "metin": "Adı da buradan gelir: basan, bastıran.",
   "bas": 391,
   "son": 498
  },
  {
   "metin": "Babaannen eski bir sandığı açtı. Bu gece yastığının altına bir muska koyacağım, dedi.",
   "bas": 498,
   "son": 708
  },
  {
   "metin": "Sen gülümsedin. İnanmıyordun ama ses de çıkarmadın.",
   "bas": 708,
   "son": 822
  },
  {
   "metin": "O gece ışığı açık bıraktın. Yastığını kaldırınca küçük, üçgen bir muska gördün.",
   "bas": 822,
   "son": 1007
  },
  {
   "metin": "Rahatladın ve uyudun.",
   "bas": 1007,
   "son": 1064
  },
  {
   "metin": "Bir fısıltı seni uyandırdı. Koridordan biri, adını söylüyordu.",
   "bas": 1064,
   "son": 1224
  },
  {
   "metin": "Babaannenin sesiydi bu.",
   "bas": 1224,
   "son": 1279
  },
  {
   "metin": "Ama babaannen yan odada, derin derin uyuyordu. Nefesini duyabiliyordun.",
   "bas": 1279,
   "son": 1464
  },
  {
   "metin": "Sen olsan o kapıyı açar mıydın? Yorumlara yaz.",
   "bas": 1464,
   "son": 1585
  }
 ],
