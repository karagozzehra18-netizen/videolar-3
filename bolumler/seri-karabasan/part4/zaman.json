 "cumleler": [
  {
   "metin": "Gözünü açtığında sabah olmuştu.",
   "bas": 0,
   "son": 67
  },
  {
   "metin": "Koridora hiç çıkmamışsın gibi, yatağındaydın.",
   "bas": 67,
   "son": 182
  },
  {
   "metin": "Babaannen seni kasabadaki doktora götürdü.",
   "bas": 182,
   "son": 280
  },
  {
   "metin": "Doktor dinledi, gülümsedi: Buna uyku felci diyoruz, dedi.",
   "bas": 280,
   "son": 435
  },
  {
   "metin": "Uyanırken beynin uyanır, ama beden bir süre daha rüyadaki gibi kımıldamaz.",
   "bas": 435,
   "son": 606
  },
  {
   "metin": "Göğüste ağırlık, odada biri varmış hissi... Bunlar çok sık anlatılır.",
   "bas": 606,
   "son": 764
  },
  {
   "metin": "Yüz kişiden yaklaşık sekizi, hayatında en az bir kez yaşar.",
   "bas": 764,
   "son": 907
  },
  {
   "metin": "Stres ve uykusuzluk bu ihtimali artırabilir.",
   "bas": 907,
   "son": 1034
  },
  {
   "metin": "Sınav haftası aklına geldi. Kendini biraz aptal hissettin.",
   "bas": 1034,
   "son": 1158
  },
  {
   "metin": "O gece muskayı yastığının altından alıp çekmeceye koydun. Işığı kapattın.",
   "bas": 1158,
   "son": 1334
  },
  {
   "metin": "Gece yarısı, aynı ağırlıkla uyandın.",
   "bas": 1334,
   "son": 1433
  },
  {
   "metin": "Ama bu sefer gözlerin karanlığa alışmıştı. Onu, açıkça görüyordun.",
   "bas": 1433,
   "son": 1615
  },
  {
   "metin": "Sen olsan muskayı geri koyar mıydın? Yorumlara yaz.",
   "bas": 1615,
   "son": 1766
  }
 ],
